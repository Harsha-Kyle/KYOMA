#include <Arduino.h>
#include <driver/i2s.h>

// ── INMP441 Mic pins ──────────────────────────────────────────────
#define MIC_SCK  20   // GPIO20
#define MIC_WS   10   // GPIO10
#define MIC_SD    2   // GPIO2
// L/R pin → GND (selects left channel)

#define SAMPLE_RATE  16000
#define BUF_SAMPLES  256

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("=== MIC TEST STARTING ===");

  i2s_config_t cfg = {
    .mode             = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate      = SAMPLE_RATE,
    .bits_per_sample  = I2S_BITS_PER_SAMPLE_32BIT,  // INMP441 outputs 32-bit
    .channel_format   = I2S_CHANNEL_FMT_ONLY_LEFT,   // L/R tied to GND = left
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count    = 8,
    .dma_buf_len      = 64,
    .use_apll         = false
  };

  i2s_pin_config_t pins = {
    .bck_io_num   = MIC_SCK,
    .ws_io_num    = MIC_WS,
    .data_out_num = I2S_PIN_NO_CHANGE,
    .data_in_num  = MIC_SD
  };

  esp_err_t err = i2s_driver_install(I2S_NUM_0, &cfg, 0, NULL);
  if (err != ESP_OK) {
    Serial.printf("I2S install failed: %d\
", err);
    return;
  }
  err = i2s_set_pin(I2S_NUM_0, &pins);
  if (err != ESP_OK) {
    Serial.printf("I2S pin set failed: %d\
", err);
    return;
  }

  Serial.println("Mic initialized! Speak into it...");
  Serial.println("Format: [Level bar] Peak value");
}

